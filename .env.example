# Panel del blog (/admin). Copia este archivo a .env.local para probar en local
# y agrega las mismas variables en Vercel → Settings → Environment Variables.

# Contraseña para entrar a /admin
ADMIN_PASSWORD=
# Cadena aleatoria larga para firmar la sesión (ej.: openssl rand -base64 32)
ADMIN_SECRET=

# Token fine-grained de GitHub con acceso solo a zomvr2/benjamonsh
# y permiso "Contents: Read and write". Sin token, en `npm run dev`
# el panel escribe directo en tu disco.
GITHUB_TOKEN=
GITHUB_REPO=zomvr2/benjamonsh
GITHUB_BRANCH=master

# Opcional: para "Desplegar ahora" y para que los programados salgan solos.
# Vercel → Settings → Git → Deploy Hooks (rama master)
VERCEL_DEPLOY_HOOK_URL=
# Vercel lo manda en el header del cron (vercel.json)
CRON_SECRET=

# «Escuchando ahora» en /enlaces y la sección Música del panel.
# API key gratis en https://www.last.fm/api/account/create (solo se usa en el servidor).
LASTFM_API_KEY=
# Tu usuario de Last.fm (por defecto: benjamonsh)
LASTFM_USER=benjamonsh

# Benjapuntos (/benjapuntos + sección del panel): backend en Appwrite Cloud.
# Consola de Appwrite → Settings, copia el endpoint exacto de tu proyecto/región.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# Consola de Appwrite → Settings → Project ID
APPWRITE_PROJECT_ID=
# Consola de Appwrite → Overview → Integrate → API Keys (scopes: databases.read, databases.write, users.read)
APPWRITE_API_KEY=
# ID de la base de datos (Databases → tu base)
APPWRITE_DATABASE_ID=benjapuntos
# IDs de las colecciones dentro de esa base
APPWRITE_OFFERS_COLLECTION_ID=offers
APPWRITE_POINTS_EVENTS_COLLECTION_ID=points_events
